#!/usr/bin/env bash
set -euo pipefail

# Optional Git pre-commit hook for Sol-Luna Orchestra.
# 1. Runs `trail check` if `.trail/` and `trail` CLI exist.
# 2. If ORCHESTRA_REVIEW_GATE=1, runs structured `neon-reviewer` against staged diff.

if [[ -d ".trail" ]] && command -v trail >/dev/null 2>&1; then
  trail check
fi

if [[ "${ORCHESTRA_REVIEW_GATE:-0}" == "1" ]]; then
  DIFF="$(git diff --cached --stat)"
  if [[ -n "$DIFF" ]]; then
    SKILL_DIR="${SOL_LUNA_SKILL_DIR:-$HOME/.omp/agent/skills/sol-luna-orchestrator}"
    OUT="$(mktemp /tmp/orchestra-precommit-XXXXXX.json)"
    trap 'rm -f "$OUT"' EXIT
    python3 "$SKILL_DIR/scripts/agy_agent.py" run \
      --role neon-reviewer \
      --cwd "$PWD" \
      --schema "$SKILL_DIR/config/review-schema.json" \
      --out "$OUT" \
      --prompt "Review staged git diff (`git diff --cached`) for P0/P1 bugs or security issues." >/dev/null
    python3 - "$OUT" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
if not data.get("ok"):
    print("Pre-commit review failed:", data.get("error"), file=sys.stderr)
    sys.exit(1)
resp = json.loads(data["response"])
if resp.get("verdict") == "BLOCKED" or any(f.get("severity") in ("P0", "P1") for f in resp.get("findings", [])):
    print("Pre-commit blocked by Neon Code Reviewer:", json.dumps(resp, indent=2), file=sys.stderr)
    sys.exit(1)
print("Orchestra pre-commit gate: PASS")
PY
  fi
fi
