#!/usr/bin/env bash
set -euo pipefail

# Unified CLI for Sol-Luna Full-Set Orchestra.
# Commands:
#   orchestra doctor
#   orchestra stats
#   orchestra sync-mcps [--dry-run]
#   orchestra route [--staged]
#   orchestra review [--staged] [--auto-fallback]
#   orchestra run <agy_agent.py run args...>
#   orchestra worktree <worktree-run.sh args...>
#   orchestra cost|guard|handoff|verify|redact ...
#   orchestra version

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
SCRIPTS_DIR="$ROOT_DIR/scripts"

CMD="${1:-help}"
shift || true

case "$CMD" in
  init|map)
    exec python3 "$SCRIPTS_DIR/discover-stack.py" "$@"
    ;;
  doctor)
    for a in "$@"; do
      if [[ "$a" == "--fix" ]]; then
        exec bash "$ROOT_DIR/install.sh" --repair
      fi
    done
    exec python3 "$SCRIPTS_DIR/agy_agent.py" doctor "$@"
    ;;
  uninstall)
    exec bash "$ROOT_DIR/install.sh" --uninstall "$@"
    ;;
  stats|run)
    exec python3 "$SCRIPTS_DIR/agy_agent.py" "$CMD" "$@"
    ;;
  sync-mcps)
    exec python3 "$SCRIPTS_DIR/sync-mcps.py" "$@"
    ;;
  cost|guard|handoff|verify|redact|phase|gate|validate)
    exec python3 "$SCRIPTS_DIR/orchestra_tools.py" "$CMD" "$@"
    ;;
  route)
    exec python3 "$SCRIPTS_DIR/smart-route.py" "$@"
    ;;
  review)
    STAGED_FLAG=""
    EXTRA_ARGS=()
    for a in "$@"; do
      if [[ "$a" == "--staged" ]]; then
        STAGED_FLAG="--cached"
      else
        EXTRA_ARGS+=("$a")
      fi
    done
    DIFF_STAT="$(git diff $STAGED_FLAG --stat)"
    if [[ -z "$DIFF_STAT" ]]; then
      echo '{"ok": true, "skipped": true, "reason": "No diff to review"}'
      exit 0
    fi
    exec python3 "$SCRIPTS_DIR/agy_agent.py" run \
      --role neon-reviewer \
      --cwd "$PWD" \
      --schema "$ROOT_DIR/config/review-schema.json" \
      "${EXTRA_ARGS[@]}" \
      --prompt "Review the git diff (${STAGED_FLAG:-working tree}) for P0-P3 bugs, contract drift, and security issues."
    ;;
  worktree)
    exec "$SCRIPTS_DIR/worktree-run.sh" "$@"
    ;;
  version|--version|-v)
    if [[ -f "$ROOT_DIR/VERSION" ]]; then
      echo "orchestra $(tr -d '[:space:]' < "$ROOT_DIR/VERSION")"
    else
      echo "orchestra (unversioned)"
    fi
    echo "skill: $ROOT_DIR"
    if git -C "$ROOT_DIR" rev-parse --short HEAD >/dev/null 2>&1; then
      echo "commit: $(git -C "$ROOT_DIR" rev-parse --short HEAD)"
    fi
    ;;
  help|-h|--help)
    cat <<'EOF'
orchestra — Sol-Luna Full-Set Orchestra CLI

Usage:
  orchestra init [--cwd PATH]              Discover repo tech stack & write .orchestra/REPO_MAP.md
  orchestra doctor                         Check agy CLI, models, and role routing
  orchestra stats                          Show telemetry ledger summary
  orchestra sync-mcps [--dry-run]          Sync Claude/Codex MCPs into OMP & AGY
  orchestra route [--staged]               Recommend optimal agents for current git diff
  orchestra review [--staged] [--auto-fallback]  Run structured Neon Code Review on diff
  orchestra cost [--days N]                Estimate tokens/USD per model from the ledger
  orchestra guard --owned "src/a/**,src/b/**"  Fail when the diff leaves owned paths
  orchestra handoff [--write]              Generate .orchestra/handoff.md from repo + ledger
  orchestra verify [--dry-run] [--only test|typecheck|lint]  Run checks and record evidence
  orchestra gate [--staged] [--no-review] [--dry-run]        Secrets + verify + review → one verdict
  orchestra redact [--staged|--file F|--history] [--check]   Find/mask secrets (exit 4 when found)
  orchestra phase start|end|status|list <name>               Tag work so cost is attributed per phase
  orchestra validate --file V.json [--schema S]              Validate a review verdict (exit 5 invalid)
  orchestra doctor --fix                                   Re-link skill, agents, and binaries
  orchestra uninstall [--force]                            Remove links/copies this installer created
  orchestra run <args...>                  Run any AGY role via agy_agent.py
  orchestra worktree <args...>             Run writable AGY agent in isolated git worktree
  orchestra version                        Print CLI + skill version and commit
EOF
    ;;
  *)
    echo "Unknown command: $CMD (run 'orchestra help')" >&2
    exit 2
    ;;
esac
