{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrchestraReviewVerdict",
  "type": "object",
  "required": ["verdict", "findings", "resolved_checks", "residual_uncertainty"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "CHANGES REQUIRED", "BLOCKED"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "file", "line", "scenario", "fix"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "scenario": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "resolved_checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "residual_uncertainty": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
